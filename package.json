{
  "name": "deen-e-safar-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "sources:prepare": "node scripts/prepare-sources.js",
    "sources:ingest": "node --env-file-if-exists=.env scripts/ingest-sources.js",
    "admin:claim": "node --env-file-if-exists=.env scripts/admin-claim.js",
    "smoke:live": "node --env-file-if-exists=.env scripts/smoke-live.js",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "firebase-admin": "^14.5.1",
    "groq-sdk": "^1.6.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2"
  }
}
