PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<url-encoded-password>@<cluster>/deen_e_safar
FIREBASE_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/secure/outside-repository/service-account.json
# Vercel alternative: save the complete Admin service-account JSON as a Secret.
# Leave GOOGLE_APPLICATION_CREDENTIALS unset when using this alternative.
FIREBASE_SERVICE_ACCOUNT_JSON=
GROQ_API_KEY=
GROQ_MODEL=
GROQ_RESPONSE_FORMAT=json_object
CLIENT_ORIGIN=http://127.0.0.1:3000,http://localhost:3000
TRUST_PROXY_HOPS=0
AI_REQUESTS_PER_MINUTE=10
AI_REQUESTS_PER_DAY=100
# Development emulator only; never set this in production.
FIREBASE_AUTH_EMULATOR_HOST=
